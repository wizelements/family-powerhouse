generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// AUTH & USERS
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  passwordHash  String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  messages      Message[]
  contributions Contribution[]
  withdrawalRequests WithdrawalRequest[]
  approvals     Approval[]
  transactions  Transaction[]
  habits        Habit[]
  habitLogs     HabitLog[]
  createdPools  Pool[] @relation("PoolCreator")
  createdTrips  Trip[] @relation("TripCreator")
  createdVentures Venture[] @relation("VentureCreator")
  tasks         Task[] @relation("TaskAssignee")
  createdTasks  Task[] @relation("TaskCreator")
  auditLogs     AuditLog[]
  notifications Notification[]
  votes         Vote[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================================
// FAMILY (TENANT)
// ============================================================================

model Family {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  settings    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  memberships    Membership[]
  channels       Channel[]
  pools          Pool[]
  budgets        Budget[]
  trips          Trip[]
  ventures       Venture[]
  invites        Invite[]
  charterVersions FamilyCharterVersion[]
  auditLogs      AuditLog[]
  notifications  Notification[]

  @@index([slug])
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  familyId  String
  role      Role     @default(MEMBER)
  status    MembershipStatus @default(ACTIVE)
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([userId, familyId])
  @@index([familyId])
  @@index([userId])
}

enum Role {
  OWNER
  TREASURER
  PLANNER
  MEMBER
  YOUTH
  GUEST
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Invite {
  id        String       @id @default(cuid())
  familyId  String
  email     String?
  token     String       @unique
  role      Role         @default(MEMBER)
  status    InviteStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime     @default(now())
  usedAt    DateTime?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([familyId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ============================================================================
// CHAT
// ============================================================================

model Channel {
  id          String      @id @default(cuid())
  familyId    String
  name        String
  type        ChannelType @default(PUBLIC)
  description String?
  isDefault   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  family   Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([familyId, name])
  @@index([familyId])
}

enum ChannelType {
  PUBLIC
  PRIVATE
  DIRECT
  ANNOUNCEMENT
}

model Message {
  id           String        @id @default(cuid())
  channelId    String
  senderId     String
  content      String        @db.Text
  type         MessageType   @default(TEXT)
  metadata     Json?
  isEdited     Boolean       @default(false)
  isDeleted    Boolean       @default(false)
  parentId     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  channel     Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender      User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  parent      Message?         @relation("MessageReplies", fields: [parentId], references: [id])
  replies     Message[]        @relation("MessageReplies")
  attachments FileAttachment[]
  reactions   Reaction[]
  mentions    Mention[]
  reports     MessageReport[]

  @@index([channelId])
  @@index([senderId])
  @@index([createdAt])
}

enum MessageType {
  TEXT
  FILE
  IMAGE
  SYSTEM
}

model FileAttachment {
  id        String   @id @default(cuid())
  messageId String?
  tripId    String?
  ventureId String?
  fileName  String
  fileType  String
  fileSize  Int
  url       String
  metadata  Json?
  createdAt DateTime @default(now())

  message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  trip    Trip?    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  venture Venture? @relation(fields: [ventureId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([tripId])
  @@index([ventureId])
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model Mention {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
}

model MessageReport {
  id        String       @id @default(cuid())
  messageId String
  reporterId String
  reason    String
  status    ReportStatus @default(PENDING)
  createdAt DateTime     @default(now())
  resolvedAt DateTime?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([status])
}

enum ReportStatus {
  PENDING
  REVIEWED
  ACTIONED
  DISMISSED
}

// ============================================================================
// MONEY POOLING
// ============================================================================

model Pool {
  id               String     @id @default(cuid())
  familyId         String
  createdById      String
  name             String
  type             PoolType
  description      String?
  targetAmount     Decimal    @db.Decimal(12, 2)
  currentAmount    Decimal    @default(0) @db.Decimal(12, 2)
  deadline         DateTime?
  status           PoolStatus @default(ACTIVE)
  approvalConfig   Json       @default("{\"requiredApprovers\": 2, \"approverRoles\": [\"OWNER\", \"TREASURER\"]}")
  metadata         Json?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  family             Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy          User                @relation("PoolCreator", fields: [createdById], references: [id])
  contributions      Contribution[]
  withdrawalRequests WithdrawalRequest[]
  ledgerEntries      LedgerEntry[]
  trip               Trip?

  @@index([familyId])
  @@index([status])
}

enum PoolType {
  TRIP
  EMERGENCY
  VENTURE
  CUSTOM
}

enum PoolStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model Contribution {
  id              String              @id @default(cuid())
  poolId          String
  userId          String
  amount          Decimal             @db.Decimal(12, 2)
  type            ContributionType    @default(ONE_TIME)
  frequency       ContributionFrequency?
  status          ContributionStatus  @default(PENDING)
  stripeSessionId String?
  stripePaymentId String?
  idempotencyKey  String              @unique
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  nextDueDate     DateTime?

  pool        Pool          @relation(fields: [poolId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id])
  ledgerEntry LedgerEntry?

  @@index([poolId])
  @@index([userId])
  @@index([status])
  @@index([idempotencyKey])
}

enum ContributionType {
  ONE_TIME
  RECURRING
  PLEDGE
}

enum ContributionFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum ContributionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

model WithdrawalRequest {
  id             String            @id @default(cuid())
  poolId         String
  requesterId    String
  amount         Decimal           @db.Decimal(12, 2)
  reason         String
  status         WithdrawalStatus  @default(PENDING)
  idempotencyKey String            @unique
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  processedAt    DateTime?

  pool        Pool          @relation(fields: [poolId], references: [id], onDelete: Cascade)
  requester   User          @relation(fields: [requesterId], references: [id])
  approvals   Approval[]
  ledgerEntry LedgerEntry?

  @@index([poolId])
  @@index([requesterId])
  @@index([status])
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
}

model Approval {
  id                  String         @id @default(cuid())
  withdrawalRequestId String
  approverId          String
  decision            ApprovalDecision?
  comment             String?
  createdAt           DateTime       @default(now())
  decidedAt           DateTime?

  withdrawalRequest WithdrawalRequest @relation(fields: [withdrawalRequestId], references: [id], onDelete: Cascade)
  approver          User              @relation(fields: [approverId], references: [id])

  @@unique([withdrawalRequestId, approverId])
  @@index([withdrawalRequestId])
  @@index([approverId])
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

model LedgerEntry {
  id                  String      @id @default(cuid())
  poolId              String
  contributionId      String?     @unique
  withdrawalRequestId String?     @unique
  type                LedgerType
  amount              Decimal     @db.Decimal(12, 2)
  balanceAfter        Decimal     @db.Decimal(12, 2)
  description         String
  idempotencyKey      String      @unique
  metadata            Json?
  createdAt           DateTime    @default(now())

  pool              Pool               @relation(fields: [poolId], references: [id], onDelete: Cascade)
  contribution      Contribution?      @relation(fields: [contributionId], references: [id])
  withdrawalRequest WithdrawalRequest? @relation(fields: [withdrawalRequestId], references: [id])

  @@index([poolId])
  @@index([createdAt])
  @@index([idempotencyKey])
}

enum LedgerType {
  CONTRIBUTION
  WITHDRAWAL
  ADJUSTMENT
  FEE
  REFUND
}

// ============================================================================
// BUDGET
// ============================================================================

model Budget {
  id        String     @id @default(cuid())
  familyId  String
  name      String
  type      BudgetType
  ownerId   String?    // For personal budgets
  poolId    String?    // For pool-linked budgets
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  family       Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  categories   BudgetCategory[]
  transactions Transaction[]
  rules        BudgetRule[]

  @@index([familyId])
  @@index([type])
}

enum BudgetType {
  HOUSEHOLD
  PERSONAL
  POOL
}

model BudgetCategory {
  id            String   @id @default(cuid())
  budgetId      String
  name          String
  monthlyLimit  Decimal  @db.Decimal(12, 2)
  color         String?
  icon          String?
  parentId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  budget       Budget           @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  parent       BudgetCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     BudgetCategory[] @relation("CategoryHierarchy")
  transactions Transaction[]

  @@unique([budgetId, name])
  @@index([budgetId])
}

model Transaction {
  id          String            @id @default(cuid())
  budgetId    String
  categoryId  String
  userId      String
  amount      Decimal           @db.Decimal(12, 2)
  type        TransactionType
  description String
  date        DateTime
  source      TransactionSource @default(MANUAL)
  isRecurring Boolean           @default(false)
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  budget   Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category BudgetCategory @relation(fields: [categoryId], references: [id])
  user     User           @relation(fields: [userId], references: [id])

  @@index([budgetId])
  @@index([categoryId])
  @@index([date])
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionSource {
  MANUAL
  CSV_IMPORT
  RECURRING
}

model BudgetRule {
  id             String         @id @default(cuid())
  budgetId       String
  name           String
  condition      Json           // e.g., { "field": "categoryId", "operator": "equals", "value": "..." }
  action         BudgetAction
  threshold      Decimal?       @db.Decimal(5, 2)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
}

enum BudgetAction {
  ALERT
  BLOCK
  NOTIFY_TREASURER
}

// ============================================================================
// TRIPS
// ============================================================================

model Trip {
  id          String     @id @default(cuid())
  familyId    String
  createdById String
  poolId      String?    @unique
  name        String
  destination String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      TripStatus @default(PLANNING)
  preferences Json?
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  family      Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("TripCreator", fields: [createdById], references: [id])
  pool        Pool?            @relation(fields: [poolId], references: [id])
  travelers   TripTraveler[]
  days        TripDay[]
  tasks       Task[]
  attachments FileAttachment[]
  votes       Vote[]
  budgetItems TripBudgetItem[]

  @@index([familyId])
  @@index([status])
}

enum TripStatus {
  PLANNING
  BOOKED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model TripTraveler {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  status    TravelerStatus @default(CONFIRMED)
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([tripId])
}

enum TravelerStatus {
  INVITED
  CONFIRMED
  DECLINED
  MAYBE
}

model TripDay {
  id        String   @id @default(cuid())
  tripId    String
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip  Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items ItineraryItem[]

  @@unique([tripId, date])
  @@index([tripId])
}

model ItineraryItem {
  id          String           @id @default(cuid())
  tripDayId   String
  title       String
  type        ItineraryType
  startTime   DateTime?
  endTime     DateTime?
  location    String?
  description String?
  cost        Decimal?         @db.Decimal(12, 2)
  isBooked    Boolean          @default(false)
  bookingRef  String?
  metadata    Json?
  order       Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tripDay TripDay @relation(fields: [tripDayId], references: [id], onDelete: Cascade)

  @@index([tripDayId])
}

enum ItineraryType {
  FLIGHT
  TRANSPORT
  LODGING
  ACTIVITY
  MEAL
  OTHER
}

model TripBudgetItem {
  id        String             @id @default(cuid())
  tripId    String
  category  TripBudgetCategory
  planned   Decimal            @db.Decimal(12, 2)
  actual    Decimal            @default(0) @db.Decimal(12, 2)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, category])
  @@index([tripId])
}

enum TripBudgetCategory {
  LODGING
  TRAVEL
  FOOD
  ACTIVITIES
  BUFFER
  OTHER
}

model Vote {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  type      VoteType
  optionId  String
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([tripId, userId, type])
  @@index([tripId])
}

enum VoteType {
  DESTINATION
  LODGING
  ACTIVITY
}

// ============================================================================
// VENTURES (Wealth Engine)
// ============================================================================

model Venture {
  id          String       @id @default(cuid())
  familyId    String
  createdById String
  name        String
  purpose     String
  stage       VentureStage @default(IDEA)
  description String?      @db.Text
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  family      Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User              @relation("VentureCreator", fields: [createdById], references: [id])
  owners      VentureOwner[]
  milestones  VentureMilestone[]
  financials  VentureFinancial[]
  attachments FileAttachment[]
  leads       OpportunityLead[]

  @@index([familyId])
  @@index([stage])
}

enum VentureStage {
  IDEA
  RESEARCH
  DEVELOPMENT
  LAUNCHED
  SCALING
  PAUSED
  CLOSED
}

model VentureOwner {
  id        String   @id @default(cuid())
  ventureId String
  userId    String
  role      String?
  createdAt DateTime @default(now())

  venture Venture @relation(fields: [ventureId], references: [id], onDelete: Cascade)

  @@unique([ventureId, userId])
  @@index([ventureId])
}

model VentureMilestone {
  id          String          @id @default(cuid())
  ventureId   String
  title       String
  description String?
  dueDate     DateTime?
  status      MilestoneStatus @default(NOT_STARTED)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  venture Venture @relation(fields: [ventureId], references: [id], onDelete: Cascade)

  @@index([ventureId])
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

model VentureFinancial {
  id          String        @id @default(cuid())
  ventureId   String
  type        FinancialType
  amount      Decimal       @db.Decimal(12, 2)
  description String
  date        DateTime
  metadata    Json?
  createdAt   DateTime      @default(now())

  venture Venture @relation(fields: [ventureId], references: [id], onDelete: Cascade)

  @@index([ventureId])
  @@index([date])
}

enum FinancialType {
  REVENUE
  EXPENSE
  INVESTMENT
}

model OpportunityLead {
  id          String      @id @default(cuid())
  ventureId   String?
  familyId    String
  name        String
  type        LeadType
  stage       LeadStage   @default(PROSPECT)
  contactInfo Json?
  notes       String?     @db.Text
  nextFollowUp DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  venture Venture? @relation(fields: [ventureId], references: [id], onDelete: SetNull)

  @@index([ventureId])
  @@index([stage])
}

enum LeadType {
  CLIENT
  PARTNER
  VENDOR
  MARKET
  OTHER
}

enum LeadStage {
  PROSPECT
  CONTACTED
  QUALIFYING
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

// ============================================================================
// TASKS
// ============================================================================

model Task {
  id          String     @id @default(cuid())
  tripId      String?
  ventureId   String?
  familyId    String
  createdById String
  assigneeId  String?
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  trip      Trip?   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy User    @relation("TaskCreator", fields: [createdById], references: [id])
  assignee  User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([tripId])
  @@index([assigneeId])
  @@index([status])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ============================================================================
// HABITS & ACCOUNTABILITY
// ============================================================================

model Habit {
  id          String         @id @default(cuid())
  userId      String
  familyId    String
  name        String
  description String?
  frequency   HabitFrequency
  targetCount Int            @default(1)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@index([userId])
  @@index([familyId])
}

enum HabitFrequency {
  DAILY
  WEEKLY
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  userId    String
  date      DateTime
  count     Int      @default(1)
  notes     String?
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([habitId, date])
  @@index([habitId])
  @@index([date])
}

model ScoreboardEntry {
  id        String   @id @default(cuid())
  familyId  String
  userId    String
  week      DateTime // Start of week
  points    Int      @default(0)
  metrics   Json     // { habits: X, tasks: Y, contributions: Z }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([familyId, userId, week])
  @@index([familyId])
  @@index([week])
}

// ============================================================================
// GOVERNANCE
// ============================================================================

model FamilyCharterVersion {
  id        String   @id @default(cuid())
  familyId  String
  version   Int
  content   String   @db.Text
  createdAt DateTime @default(now())

  family      Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  signoffs    CharterSignoff[]

  @@unique([familyId, version])
  @@index([familyId])
}

model CharterSignoff {
  id               String   @id @default(cuid())
  charterVersionId String
  userId           String
  signedAt         DateTime @default(now())

  charterVersion FamilyCharterVersion @relation(fields: [charterVersionId], references: [id], onDelete: Cascade)

  @@unique([charterVersionId, userId])
  @@index([charterVersionId])
}

// ============================================================================
// NOTIFICATIONS & AUDIT
// ============================================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  familyId  String
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([isRead])
}

enum NotificationType {
  POOL_CONTRIBUTION
  POOL_DEADLINE
  POOL_TARGET_MET
  WITHDRAWAL_REQUESTED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  BUDGET_ALERT
  TRIP_INVITE
  TRIP_UPDATE
  TASK_ASSIGNED
  MENTION
  SYSTEM
}

model AuditLog {
  id         String     @id @default(cuid())
  familyId   String
  userId     String
  event      AuditEvent
  targetType String
  targetId   String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime   @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([familyId])
  @@index([userId])
  @@index([event])
  @@index([createdAt])
}

enum AuditEvent {
  // Auth
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  PASSWORD_CHANGE
  
  // Family
  FAMILY_CREATED
  MEMBER_INVITED
  MEMBER_REMOVED
  ROLE_CHANGED
  SETTINGS_CHANGED
  
  // Financial
  POOL_CREATED
  POOL_UPDATED
  CONTRIBUTION_MADE
  WITHDRAWAL_REQUESTED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  WITHDRAWAL_PROCESSED
  
  // Budget
  BUDGET_CREATED
  BUDGET_MODIFIED
  TRANSACTION_ADDED
  
  // Trip
  TRIP_CREATED
  TRIP_UPDATED
  
  // Venture
  VENTURE_CREATED
  VENTURE_UPDATED
}
